# Kong конфигурация для канареечного развертывания (шаблон)
# Этот файл будет обработан для замены переменных окружения

_format_version: "3.0"
_transform: true

# Определение апстрима с весовой балансировкой
upstreams:
  - name: movie-upstream
    algorithm: round-robin
    healthchecks:
      active:
        type: http
        http_path: /
        healthy:
          interval: 30
          successes: 2
        unhealthy:
          interval: 30
          http_failures: 3
    tags:
      - movies
      - canary

# Цели с весами для канареечного развертывания
targets:
  - target: old-movie-service:80
    upstream: movie-upstream
    weight: ${OLD_MOVIE_SERVICE_PERCENT}
    tags:
      - legacy

  - target: new-movie-service:80
    upstream: movie-upstream
    weight: ${NEW_MOVIE_SERVICE_PERCENT}
    tags:
      - canary

# Определение сервиса
services:
  - name: movie-service
    url: http://movie-upstream
    retries: 5
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    tags:
      - movies

# Определение маршрута
routes:
  - name: movie-route
    service: movie-service
    paths:
      - /kong_requests_movies
    strip_path: true
    methods:
      - GET
      - POST
      - PUT
      - DELETE
      - PATCH
    preserve_host: false
    tags:
      - movies

# Простые плагины (без Lua)
plugins:
  # Добавление заголовков для отладки
  - name: response-transformer
    route: movie-route
    config:
      add:
        headers:
          - "X-Kong-Upstream:movie-upstream"
          - "X-API-Version:v1"
          - "X-Canary-Enabled:true"
          - "X-Canary-Percent:${NEW_MOVIE_SERVICE_PERCENT}"
          - "X-Served-By:kong-gateway"
    tags:
      - headers

  # Логирование запросов
  - name: file-log
    route: movie-route
    config:
      path: /tmp/kong-movie-requests.log
    tags:
      - logging

  # Уникальный ID запроса
  - name: correlation-id
    route: movie-route
    config:
      header_name: X-Request-ID
      generator: uuid
      echo_downstream: true
    tags:
      - tracing

  # Ограничение частоты запросов (защита от перегрузки)
  - name: rate-limiting
    route: movie-route
    config:
      minute: 1000
      hour: 10000
      policy: local
      fault_tolerant: true
      hide_client_headers: false
    tags:
      - protection