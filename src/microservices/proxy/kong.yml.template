# Kong-конфигурация для канареечного развертывания (шаблон)
# Этот файл будет обработан для замены переменных окружения

_format_version: "3.0"
_transform: true

# Определение апстрима с весовой балансировкой
upstreams:
#  - name: test-movie-upstream
#    algorithm: round-robin
#    healthchecks:
#      active:
#        type: http
#        http_path: /
#        healthy:
#          interval: 30
#          successes: 2
#        unhealthy:
#          interval: 30
#          http_failures: 3
#    tags:
#      - movies
#      - canary

  - name: movie-upstream
    algorithm: round-robin
    tags:
      - movies
      - canary

  - name: events-upstream
    algorithm: round-robin
    tags:
      - events

  - name: monolith-upstream
    algorithm: round-robin
    tags:
      - events

# Цели с весами для канареечного развертывания
targets:
#  - target: test-old-movie-service:80
#    upstream: test-movie-upstream
#    weight: ${OLD_MOVIE_SERVICE_PERCENT}
#    tags:
#      - legacy
#      - test
#
#  - target: test-new-movie-service:80
#    upstream: test-movie-upstream
#    weight: ${NEW_MOVIE_SERVICE_PERCENT}
#    tags:
#      - canary
#      - test

  - target: ${MONOLITH_SERVICE_URL}
    upstream: movie-upstream
    weight: ${OLD_MOVIE_SERVICE_PERCENT}
    tags:
      - legacy
      - movies

  - target: ${MOVIE_SERVICE_URL}
    upstream: movie-upstream
    weight: ${NEW_MOVIE_SERVICE_PERCENT}
    tags:
      - canary
      - movies

  - target: ${EVENTS_SERVICE_URL}
    upstream: events-upstream
    weight: 100
    tags:
      - events

  - target: ${MONOLITH_SERVICE_URL}
    upstream: monolith-upstream
    weight: 100
    tags:
      - monolith


# Определение сервиса
services:
#  - name: test-movie-service
#    url: http://test-movie-upstream
#    retries: 5
#    connect_timeout: 60000
#    write_timeout: 60000
#    read_timeout: 60000
#    tags:
#      - movies
#      - test

  - name: movie-service
    url: http://movie-upstream
    retries: 5
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    tags:
      - movies

  - name: events-service
    url: http://events-upstream
    retries: 5
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    tags:
      - events

  - name: monolith-service
    url: http://monolith-upstream
    retries: 5
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000


# Определение маршрута
routes:
#  - name: test-movie-route
#    service: test-movie-service
#    paths:
#      - /kong_requests_movies
#    strip_path: true
#    methods:
#      - GET
#      - POST
#      - PUT
#      - DELETE
#      - PATCH
#    preserve_host: false
#    tags:
#      - movies
#      - test

  - name: movie-route
    service: movie-service
    paths:
      - /api/movies
    strip_path: false
    methods:
      - GET
      - POST
      - PUT
      - DELETE
      - PATCH
    preserve_host: false
    tags:
      - movies

  - name: events-route
    service: events-service
    paths:
      - /api/events
    strip_path: false
    methods:
      - GET
      - POST
      - PUT
      - DELETE
      - PATCH
    preserve_host: false
    tags:
      - events

  - name: monolith-route
    service: monolith-service
    paths:
      - /
    strip_path: false
    methods:
      - GET
      - POST
      - PUT
      - DELETE
      - PATCH
    preserve_host: false
    tags:
      - monolith

# Простые плагины (без Lua)
plugins:
  # Добавление заголовков для отладки
  - name: response-transformer
#    route: movie-route
    config:
      add:
        headers:
          - "X-Kong-Upstream:movie-upstream"
          - "X-API-Version:v1"
          - "X-Canary-Enabled:true"
          - "X-Canary-Percent:${NEW_MOVIE_SERVICE_PERCENT}"
          - "X-Served-By:kong-gateway"
    tags:
      - headers

  # Логирование запросов
  - name: file-log
#    route: movie-route
    config:
      path: /tmp/kong-requests.log
    tags:
      - logging

  # Уникальный ID запроса
  - name: correlation-id
#    route: movie-route
    config:
      header_name: X-Request-ID
      generator: uuid
      echo_downstream: true
    tags:
      - tracing

  # Ограничение частоты запросов (защита от перегрузки)
  - name: rate-limiting
#    route: movie-route
    config:
      minute: 1000
      hour: 10000
      policy: local
      fault_tolerant: true
      hide_client_headers: false
    tags:
      - protection