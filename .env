# Kong Canary Deployment Environment Variables
# Эти переменные будут использованы только если они не установлены вручную в системе


# Процент трафика, направляемого на новый сервис (0-100)
# Работает только когда MIGRATE_TO_MOVIES=true
NEW_MOVIE_SERVICE_PERCENT=80

# URL сервисов (используются по умолчанию для Docker Compose)
# В продакшене замените на реальные адреса ваших сервисов
OLD_MOVIE_SERVICE_URL=http://old-movie-service:80
NEW_MOVIES_SERVICE_URL=http://new-movie-service:80

# Kong конфигурация
KONG_ADMIN_URL=http://localhost:8001

# Дополнительные переменные для мониторинга (опционально)
KONG_LOG_LEVEL=info
KONG_NGINX_WORKER_PROCESSES=auto

# Настройки базы данных (опционально - можно переопределить)
POSTGRES_USER=kong
POSTGRES_PASSWORD=kongpass
POSTGRES_DB=kong

# Примеры различных сценариев канареечного развертывания:
#
# Сценарий 1: Полное отключение канареечного развертывания
# MIGRATE_TO_MOVIES=false
# NEW_MOVIE_SERVICE_PERCENT=0
#
# Сценарий 2: Осторожное тестирование с 5% трафика
# MIGRATE_TO_MOVIES=true
# NEW_MOVIE_SERVICE_PERCENT=5
#
# Сценарий 3: A/B тестирование 50/50
# MIGRATE_TO_MOVIES=true
# NEW_MOVIE_SERVICE_PERCENT=50
#
# Сценарий 4: Почти полное переключение (95% на новый сервис)
# MIGRATE_TO_MOVIES=true
# NEW_MOVIE_SERVICE_PERCENT=95
#
# Сценарий 5: Полное переключение на новый сервис
# MIGRATE_TO_MOVIES=true
# NEW_MOVIE_SERVICE_PERCENT=100

# ВАЖНО: Приоритет переменных окружения:
# 1. Переменные, установленные вручную в shell (export MIGRATE_TO_MOVIES=true)
# 2. Переменные из этого .env файла
# 3. Значения по умолчанию в docker-compose.yml
#
# Примеры переопределения:
# export MIGRATE_TO_MOVIES=true && docker-compose up -d    # переопределит значение из .env
# docker-compose up -d                                     # использует значения из .env